# Copy to .env and fill in (never commit real secrets)
FLASK_ENV=development
SECRET_KEY=dev-change-me-in-env
# NOTE: Flask-SQLAlchemy resolves a *relative* sqlite path against the
# app instance folder, so this creates <repo>/instance/vybe.db.
# (Same location as config.py's absolute default.) Do NOT change this to
# sqlite:///instance/vybe.db — that would resolve to instance/instance/vybe.db
# and crash with "unable to open database file".
DATABASE_URL=sqlite:///vybe.db
# Optional AI onboarding (app works WITHOUT this):
# VYBE_AI_API_URL=
# VYBE_AI_API_KEY=
# VYBE_AI_MODEL=
