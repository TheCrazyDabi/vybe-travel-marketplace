# ==============================================================================
# VYBE Travel Marketplace — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` for local development. Never commit `.env` with real credentials.

# --- Core Flask Settings ---
FLASK_ENV=development
# In production, set a cryptographically secure 32+ character random string
SECRET_KEY=dev-change-me-in-env
PORT=5000

# --- Database Configuration ---
# Local SQLite (default for development and automated tests):
DATABASE_URL=sqlite:///vybe.db
# Production Supabase Managed PostgreSQL:
# Format: postgresql+psycopg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL=postgresql+psycopg://postgres.yourproject:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# --- Supabase Platform Services (Auth, Storage & Database) ---
SUPABASE_URL=https://your-project-id.supabase.co
# Client-safe public anonymous key (read-only / authenticated user scope)
SUPABASE_ANON_KEY=your-supabase-anon-key-here
# Server-only service role key (Never expose in frontend, Android app, or logs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
SUPABASE_STORAGE_BUCKET=vybe-packages

# --- Automatic Expiry & Cleanup Cron Settings ---
# Bearer secret required to trigger POST /api/cron/cleanup from external cron / pg_cron
CRON_SECRET=your-random-32-character-cron-secret
# Days to retain expired packages without bookings before eligible for permanent pruning (default 90)
CLEANUP_RETENTION_DAYS=90

# --- Cloudflare R2 Object Storage (Alternative S3-compatible Document & Image Storage) ---
# When omitted, uploads fall back to Supabase Storage or local disk in ./uploads
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=vybe-uploads
R2_PUBLIC_BASE_URL=

# --- Razorpay Payment Gateway (INR) ---
# When omitted, booking checkout runs in secure simulated/testing mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cookie Security (Enable in Production) ---
# SESSION_COOKIE_SECURE=true
# SESSION_COOKIE_HTTPONLY=true
# SESSION_COOKIE_SAMESITE=Lax

# --- Optional AI Assistant Settings (Works gracefully without these) ---
# VYBE_AI_API_URL=
# VYBE_AI_API_KEY=
# VYBE_AI_MODEL=
