<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.VYBE" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/vybe_accent</item>
        <item name="colorPrimaryVariant">@color/vybe_card</item>
        <item name="colorOnPrimary">@color/vybe_bg</item>
        
        <!-- Status bar color -->
        <item name="android:statusBarColor">@color/vybe_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        
        <!-- Navigation bar color -->
        <item name="android:navigationBarColor">@color/vybe_bg</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
        
        <!-- Window background -->
        <item name="android:windowBackground">@color/vybe_bg</item>
    </style>
</resources>
