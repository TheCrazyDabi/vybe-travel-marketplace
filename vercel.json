{
  "version": 2,
  "regions": ["syd1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{templates/**,static/**,data/**}"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": "/api/index?__route=/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index?__route=/$1"
    }
  ]
}
