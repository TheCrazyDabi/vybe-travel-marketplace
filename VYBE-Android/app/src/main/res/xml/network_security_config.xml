<?xml version="1.0" encoding="utf-8"?>
<!-- Release-safe default: HTTPS only, no cleartext. The debug overlay
     (src/debug/res/xml/network_security_config.xml) permits cleartext
     for laptop development (10.0.2.2 emulator loopback + LAN). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
