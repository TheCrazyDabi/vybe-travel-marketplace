<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY (never shipped in release builds): allow cleartext HTTP so the
     app can reach the laptop dev server (emulator 10.0.2.2 or any laptop LAN
     IP). Release builds use the strict HTTPS-only config. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
