# VYBE — Production-hardened Git Ignore Rules

# Local secrets & environment files
.env
.env.*
!.env.example
*.env

# Certificates, keys and credentials
*.pem
*.key
*.crt
*.cert
*.pfx
*service_account*.json
*firebase*.json
google-services.json

# Local Uploads & Static User Media
uploads/
instance/uploads/
instance/*.db
instance/*.sqlite
*.db
*.sqlite
*.sqlite3

# Virtual environments
.venv/
venv/
env/
ENV/

# Python caches and bytecode
__pycache__/
*.py[codz]
*$py.class
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.log
*.tmp
*.bak
*.swp
*~

# Local development files
instance/*
!instance/.gitkeep
VYBE_MASTER_BUILD_PROMPT.md

# Android build outputs & local sdk properties
.gradle/
**/build/
local.properties
*.apk
*.aab

