# VYBE — minimal, hackathon-focused ignore rules

# Local secrets / env
.env
.env.local

# Virtual envs
.venv/
venv/
env/

# Python caches
__pycache__/
*.py[codz]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Flask / local runtime (regenerates on `python app.py` / run.bat)
instance/*
!instance/.gitkeep
*.db
*.sqlite
*.sqlite3

# Uploads (demo docs/logos stay local)

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Local-only file at repo root (not part of the product repo)
VYBE_MASTER_BUILD_PROMPT.md
